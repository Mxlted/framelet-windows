<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/framelet.ico</ApplicationIcon>
    <AssemblyName>Framelet</AssemblyName>
    <RootNamespace>Framelet.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../Framelet.Core/Framelet.Core.csproj" />
    <ProjectReference Include="../Framelet.Recording/Framelet.Recording.csproj" />
    <ProjectReference Include="../Framelet.NativeHost/Framelet.NativeHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Framelet.Media\Framelet.Media.csproj" />
  </ItemGroup>
  <Target Name="CopyNativeHost" AfterTargets="Build">
    <ItemGroup><NativeHostFiles Include="../Framelet.NativeHost/bin/$(Platform)/$(Configuration)/$(TargetFramework)/Framelet.NativeHost.*" /></ItemGroup>
    <Copy SourceFiles="@(NativeHostFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
