<Window x:Class="Framelet.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="clr-namespace:Framelet.App.Editor" Title="Framelet" Width="1240" Height="820" MinWidth="1000" MinHeight="660" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown">
  <Window.Style><StaticResource ResourceKey="{x:Type Window}"/></Window.Style>
  <Window.Resources>
    <Style x:Key="NavigationButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Height" Value="56"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="GroupName" Value="WorkspacePage"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Mark" Width="3" HorizontalAlignment="Left" Margin="0,9" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavigationIcon" TargetType="Path"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource TextBrush}"/><Setter Property="StrokeThickness" Value="1.6"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="NavigationLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Width="23" Height="23" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Data="M 0,8 L 0,0 8,0 M 14,0 L 22,0 22,8 M 22,14 L 22,22 14,22 M 8,22 L 0,22 0,14 M 6,6 L 16,6 16,16 6,16 Z"/><TextBlock Text="Framelet" FontSize="19" FontWeight="SemiBold" Margin="11,0,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="_Capture ▾" ToolTip="Capture a region, window, monitor, or all displays" Click="CaptureMenu" Margin="0,0,7,0"/><Button Content="Record clip" Click="RecordClick" Margin="0,0,18,0"/><Button Content="_Open image" ToolTip="Open an image (Ctrl+O)" Click="OpenClick" Background="Transparent" BorderThickness="0"/><Button Content="_Paste" ToolTip="Paste an image (Ctrl+V)" Click="PasteClick" Background="Transparent" BorderThickness="0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CopyButton" Content="Copy image" ToolTip="Copy flattened image (Ctrl+C)" Click="CopyClick" IsEnabled="False" Margin="0,0,7,0"/><Button x:Name="SaveButton" Content="Save image" ToolTip="Save image as… (Ctrl+S)" Style="{StaticResource PrimaryButton}" Click="SaveClick" IsEnabled="False" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="5,8">
          <Button DockPanel.Dock="Bottom" Click="SettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings" Background="Transparent" BorderThickness="0" Padding="2,8"><StackPanel><Path Style="{StaticResource NavigationIcon}" Data="M 2,5 L 22,5 M 2,12 L 22,12 M 2,19 L 22,19 M 7,2 L 7,8 M 17,9 L 17,15 M 9,16 L 9,22"/><TextBlock Text="Settings" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
          <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton x:Name="HomeNav" Tag="home" Checked="NavigationSelected" Style="{StaticResource NavigationButton}" IsChecked="True" Click="HomeClick" ToolTip="Home and recent files" AutomationProperties.Name="Home"><StackPanel><Path Style="{StaticResource NavigationIcon}" Data="M 2,10 L 12,2 22,10 M 5,9 L 5,22 10,22 10,15 14,15 14,22 19,22 19,9"/><TextBlock Text="Home" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton>
            <RadioButton x:Name="EditorNav" Tag="editor" Checked="NavigationSelected" Style="{StaticResource NavigationButton}" Click="EditorClick" ToolTip="Image editor" AutomationProperties.Name="Image editor"><StackPanel><Path Style="{StaticResource NavigationIcon}" Data="M 2,2 L 22,2 22,22 2,22 Z M 2,17 L 8,11 13,16 17,12 22,17 M 16,6 L 18,6 18,8 16,8 Z"/><TextBlock Text="Editor" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton>
            <RadioButton x:Name="ClipsNav" Tag="clips" Checked="NavigationSelected" Style="{StaticResource NavigationButton}" Click="ClipsClick" ToolTip="Clip preview and trim" AutomationProperties.Name="Clip preview and trim"><StackPanel><Path Style="{StaticResource NavigationIcon}" Data="M 3,2 L 21,12 3,22 Z"/><TextBlock Text="Clips" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="28,24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20"><TextBlock Text="Capture &amp; edit" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Start a capture, open an image, or paste from your clipboard." Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" Padding="16">
                <DockPanel><Button Content="Capture region" Click="RegionClick" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Screenshot" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CaptureHint" Text="Ctrl + Shift + 2" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel>
              </Border>
              <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" Padding="16">
                <DockPanel><Button Content="Record clip" Click="RecordClick" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Recording" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="BackendHint" Text="Native · 60 FPS · MP4" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
              </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,26,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recent files" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="OpenRecentButton" Grid.Column="1" Content="Open selected" Click="RecentOpenClick" IsEnabled="False" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Open output folder" Click="FolderClick" Background="Transparent"/></Grid>
            <TextBlock x:Name="OutputFolder" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="4"><ListBox x:Name="RecentList" MouseDoubleClick="RecentOpen" PreviewKeyDown="RecentKeyDown" SelectionChanged="RecentSelectionChanged" AutomationProperties.Name="Recent images and clips" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Border x:Name="EmptyRecent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20"><StackPanel><TextBlock Text="No saved captures yet" FontWeight="SemiBold"/><TextBlock Text="Save an image or recording to your output folder to see it here. You can also drop an image or clip into Framelet." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></StackPanel>
          </Grid>
        </ScrollViewer>
        <editor:ImageEditorView x:Name="Editor" Visibility="Collapsed"/>
        <ContentControl x:Name="ClipHost" Visibility="Collapsed"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="16,0"><TextBlock DockPanel.Dock="Right" Text="LOCAL ONLY" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="Status" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="Ready" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
</Window>
