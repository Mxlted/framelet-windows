<UserControl x:Class="Framelet.App.Editor.ImageEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Framelet.App.Editor"
             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
             Focusable="True" PreviewKeyDown="OnPreviewKeyDown" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,8"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UndoButton" Content="↶" FontSize="20" Width="34" Padding="0" Margin="2,0" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"/>
                    <Button x:Name="RedoButton" Content="↷" FontSize="20" Width="34" Padding="0" Margin="2,0" Click="OnRedo" ToolTip="Redo (Ctrl+Shift+Z)" AutomationProperties.Name="Redo"/>
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4"/>
                    <Button Content="Resize" Click="OnResize" Padding="10,3" ToolTip="Resize image and annotations" Margin="0,0,6,0"/>
                    <Button x:Name="ObjectsToggle" Content="Objects" Click="OnToggleObjects" Padding="10,3" ToolTip="Show or hide the object list"/>
                </StackPanel>
                <TextBlock x:Name="ToolTitle" Text="Select" FontWeight="SemiBold" Width="72" VerticalAlignment="Center"/>
                <StackPanel x:Name="StyleOptions" Orientation="Horizontal">
                    <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StrokeLabel" Text="Width" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="WidthPicker" Width="56" SelectionChanged="OnWidthChanged" SelectedIndex="1" VerticalContentAlignment="Center" ToolTip="Stroke width in image pixels">
                        <ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="10"/><ComboBoxItem Content="16"/>
                    </ComboBox>
                    <CheckBox x:Name="FillToggle" Content="Fill" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnFillChanged"/>
                </StackPanel>
                <StackPanel x:Name="TextOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBox x:Name="AnnotationTextBox" Width="180" Text="Your text" VerticalContentAlignment="Center" TextChanged="OnTextChanged" LostKeyboardFocus="OnTextCommit" PreviewKeyDown="OnTextKeyDown" ToolTip="Text content; press Enter to apply"/>
                    <ComboBox x:Name="FontPicker" Width="60" Margin="6,0,0,0" SelectionChanged="OnFontChanged" SelectedIndex="2" ToolTip="Font size in image pixels">
                        <ComboBoxItem Content="14"/><ComboBoxItem Content="18"/><ComboBoxItem Content="24"/><ComboBoxItem Content="32"/><ComboBoxItem Content="48"/><ComboBoxItem Content="64"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="EffectOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Strength" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="EffectPicker" Width="68" SelectionChanged="OnEffectChanged" SelectedIndex="1">
                        <ComboBoxItem Content="6"/><ComboBoxItem Content="12"/><ComboBoxItem Content="20"/><ComboBoxItem Content="32"/><ComboBoxItem Content="48"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="CropOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="CropSize" Text="Drag to choose a crop" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0"/>
                    <Button Content="Apply crop" Click="OnApplyCrop" Padding="12,3" ToolTip="Apply crop (Enter)"/>
                    <Button Content="Cancel" Click="OnCancelCrop" Padding="10,3" Margin="6,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ObjectsColumn" Width="190"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ToolRail" Margin="0,8">
                        <Button Style="{StaticResource ToolButton}" Tag="Select" Click="OnToolClick" ToolTip="Select and move (V)" AutomationProperties.Name="Select tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 3,2 L 3,18 7,14 11,22 15,20 11,12 17,12 Z"/><TextBlock Text="Select" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Arrow" Click="OnToolClick" ToolTip="Arrow (A). Hold Shift to constrain." AutomationProperties.Name="Arrow tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 3,19 L 19,3 M 9,3 L 19,3 19,13"/><TextBlock Text="Arrow" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Rectangle" Click="OnToolClick" ToolTip="Rectangle (R). Hold Shift for a square." AutomationProperties.Name="Rectangle tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 2,4 L 21,4 21,19 2,19 Z"/><TextBlock Text="Shape" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Ellipse" Click="OnToolClick" ToolTip="Ellipse (O). Hold Shift for a circle." AutomationProperties.Name="Ellipse tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 22,12 A 10,8 0 1 1 2,12 A 10,8 0 1 1 22,12"/><TextBlock Text="Ellipse" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Text" Click="OnToolClick" ToolTip="Text (T). Click to place text." AutomationProperties.Name="Text tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 3,3 L 21,3 M 12,3 L 12,22 M 7,22 L 17,22 M 3,3 L 3,7 M 21,3 L 21,7"/><TextBlock Text="Text" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Pen" Click="OnToolClick" ToolTip="Freehand pen (P)" AutomationProperties.Name="Pen tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 3,20 L 4,15 17,2 22,7 9,20 Z M 4,15 L 9,20 M 14,5 L 19,10"/><TextBlock Text="Draw" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Highlight" Click="OnToolClick" ToolTip="Highlight (H)" AutomationProperties.Name="Highlight tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 3,15 L 12,4 20,10 11,21 Z M 3,15 L 9,20 M 2,23 L 15,23"/><TextBlock Text="Highlight" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Border Height="1" Margin="14,6" Background="{DynamicResource BorderBrush}"/>
                        <Button Style="{StaticResource ToolButton}" Tag="Blur" Click="OnToolClick" ToolTip="Blur (B)" AutomationProperties.Name="Blur tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 5,3 L 5,21 M 10,5 L 10,19 M 15,3 L 15,21 M 20,5 L 20,19"/><TextBlock Text="Blur" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Pixelate" Click="OnToolClick" ToolTip="Pixelate (X)" AutomationProperties.Name="Pixelate tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 2,2 L 10,2 10,10 2,10 Z M 14,2 L 22,2 22,10 14,10 Z M 2,14 L 10,14 10,22 2,22 Z M 14,14 L 22,14 22,22 14,22 Z"/><TextBlock Text="Pixelate" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Crop" Click="OnToolClick" ToolTip="Crop (C). Enter applies; Escape cancels." AutomationProperties.Name="Crop tool"><StackPanel><Path Style="{StaticResource ToolIcon}" Data="M 2,6 L 18,6 18,22 M 6,2 L 6,18 22,18"/><TextBlock Text="Crop" Style="{StaticResource SmallLabel}"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnViewportWheel" PreviewMouseDown="OnViewportMouseDown" PreviewMouseMove="OnViewportMouseMove" PreviewMouseUp="OnViewportMouseUp" SizeChanged="OnViewportSizeChanged" Background="{DynamicResource BackgroundBrush}">
                    <Grid x:Name="CanvasHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border BorderBrush="#30000000" BorderThickness="1">
                            <local:EditorSurface x:Name="Surface"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="24">
                    <Path Data="M 4,4 L 52,4 52,44 4,44 Z M 4,34 L 18,20 29,31 37,23 52,38 M 42,14 A 4,4 0 1 1 34,14 A 4,4 0 1 1 42,14" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Width="56" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Capture or open an image" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop an image here, or paste from your clipboard." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Your annotations stay editable until you export." Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
            <Border x:Name="ObjectsPanel" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14,17">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="OBJECTS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="ObjectCount" Text="No annotations yet" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14"/>
                        <WrapPanel>
                            <Button Content="↑" Width="34" Height="30" Margin="0,0,5,5" Click="OnForward" ToolTip="Bring forward (Ctrl+])" AutomationProperties.Name="Bring object forward"/>
                            <Button Content="↓" Width="34" Height="30" Margin="0,0,5,5" Click="OnBackward" ToolTip="Send backward (Ctrl+[)" AutomationProperties.Name="Send object backward"/>
                            <Button Content="Duplicate" Height="30" Padding="7,0" Margin="0,0,0,5" Click="OnDuplicate" ToolTip="Duplicate selected object (Ctrl+D)"/>
                        </WrapPanel>
                        <Button Content="Delete object" Click="OnDelete" Margin="0,1,0,16" ToolTip="Delete selected object (Delete)"/>
                        <TextBlock Text="Move precisely" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="Arrow keys nudge 1 px.&#10;Shift moves 10 px." FontSize="11" Foreground="{DynamicResource MutedBrush}" LineHeight="17"/>
                        <TextBlock Text="Scroll to move the canvas.&#10;Ctrl + scroll to zoom.&#10;Middle-drag or Space-drag to pan." FontSize="11" Foreground="{DynamicResource MutedBrush}" LineHeight="17" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="ObjectList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" SelectionChanged="OnObjectSelected" DisplayMemberPath="Label" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,8"/><Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="−" Width="28" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZoomOut" ToolTip="Zoom out"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    <Button Content="+" Width="28" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZoomIn" ToolTip="Zoom in"/>
                    <Button Content="Fit" Padding="8,0" Margin="7,3,0,3" Click="OnFit" ToolTip="Fit image to workspace (Ctrl+0)"/>
                    <Button Content="1:1" Padding="8,0" Margin="5,3,0,3" Click="OnActualSize" ToolTip="Actual pixels (Ctrl+1)"/>
                </StackPanel>
                <TextBlock x:Name="DimensionsLabel" Text="No image" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,18,0"/>
                <TextBlock x:Name="StatusLabel" Text="Local files. No uploads." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
