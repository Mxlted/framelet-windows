<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Framelet.Media/Framelet.Media.csproj" />
    <ProjectReference Include="../../src/Framelet.Recording/Framelet.Recording.csproj" />
    <ProjectReference Include="../../src/Framelet.NativeHost/Framelet.NativeHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyNativeHost" AfterTargets="Build">
    <ItemGroup>
      <NativeHostFiles Include="../../src/Framelet.NativeHost/bin/$(Platform)/$(Configuration)/$(TargetFramework)/Framelet.NativeHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeHostFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
